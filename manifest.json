{
  "manifest_version": 3,
  "name": "StockPulse Companion",
  "version": "1.0.0",
  "description": "Live niche score HUD on Adobe Stock search + one-click keyword copy on asset pages. Companion to StockPulse Pro.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://stock.adobe.com/search*", "*://stock.adobe.com/*/search*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://stock.adobe.com/*/images/*", "*://stock.adobe.com/images/*", "*://stock.adobe.com/*/video/*"],
      "js": ["asset.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
